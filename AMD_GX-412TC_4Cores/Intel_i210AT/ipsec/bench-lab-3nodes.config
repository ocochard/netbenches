#!/bin/sh
# IPsec bench: generator and receiver on one node, DUT, IPsec peer endpoint.
# -------------------admin network: 192.168.100.0/24 (ssh)---------------------
#          | .4                          | .43                        | .46
# +-----------------------+   +--------------------------+   +----------------------------+
# |  Supermicro (sm1)     |   |    PC Engines APU2 (apu2-3)  |   |   Supermicro (sm2)     |
# |  Packet generator     |   |      Device under Test   |   |      IPsec endpoint        |
# |  and receiver         |   |      (AES-NI)            |   |      (AES-NI)              |
# |                       |   |                          |   |                            |
# | igb1: 198.18.0.203/24 |=>=| igb1: 198.18.0.205/24    |   |                            |
# |        2001:2::203/64 |   |        2001:2::205/64    |   |                            |
# |     0c:c4:7a:ab:29:35 |   |     00:0d:b9:45:7a:d5    |   |                            |
# |                       |   |                          |   |                            |
# |                       |   | igb2: 198.18.1.205/24    |=>=| igb1: 198.18.1.203/24      |
# |                       |   |     2001:2:0:1::205/64   |   |      2001:2:0:1::203/64    |
# |                       |   |     00:0d:b9:45:7a:d6    |   |     0c:c4:7a:da:3c:11      |
# |                       |   |                          |   |                            |
# |                       |   |      static routes       |   |      static routes         |
# |                       |   | 198.19.0.0/16 =>         |   | 198.19.0.0/16 =>           |
# |                       |   |          198.18.1.203    |   |          198.19.0.203      |
# |                       |   | 198.18.0.0/16 =>         |   | 198.18.0.0/16 =>           |
# |                       |   |          198.18.0.203    |   |          198.18.1.205      |
# |                       |   |                          |   |                            |
# | igb2: 198.19.0.203/24 |=<=|                          |=<=| igb2: 198.19.0.201/24      |
# | 2001:2:0:8000::203/64 |   |                          |   |  2001:2:0:8000::201/64     |
# |     0c:c4:7a:ab:29:36 |   |                          |   |     0c:c4:7a:da:3c:12      |
# +-----------------------+   +--------------------------+   +----------------------------+
#            /\                                                            ||
#            ===============================<============================= ||
#
# Traffic path: sm1 igb1 => apu2-3 (encrypt) => sm2 (decrypt) => sm1 igb2
# The ESP tunnel runs between 198.18.1.205 (DUT) and 198.18.1.203 (peer).

# Admin network IP
SENDER_ADMIN="192.168.100.4"	# sm1
RECEIVER_ADMIN="192.168.100.4"	# sm1
DUT_ADMIN="192.168.100.43"	# apu2-3
REF_ADMIN="192.168.100.46"	# sm2

# LAB network IP and data
SENDER_LAB_IP="198.18.0.203"
RECEIVER_LAB_IP="198.19.0.203"

#netmap pkt-gen need these information:
SENDER_LAB_IF="igb1"
SENDER_LAB_MAC="0c:c4:7a:ab:29:35"
RECEIVER_LAB_IF="igb2"
DUT_LAB_IF_MAC_SENDER_SIDE="00:0d:b9:45:7a:d5"
# Address family of the run: 4 or 6. Set it from the command line
# (AF=6 bench-lab.sh ...) to bench IPv6, like the existing result sets do.
# The flows, the offered load and the packet size are chosen by equilibrium
# itself, so there is no SENDER_LAB_NET / PKT_SIZE / PKT_TO_SEND here.
: ${AF:="4"}

#PMC event
: ${PMC_EVENT:="BU_CPU_CLK_UNHALTED"}

#Timeout : Number of seconds / 5 to wait before declaring a problem for DUT rebooting process
REBOOT_TIMEOUT=60

# Is DUT online: Test command
# The ref endpoint is rebooted before the DUT, so this must also prove the
# DUT reaches the far side of the tunnel (traffic is dropped until the peer
# has loaded its SAD/SPD).
IS_DUT_ONLINE_TARGET=${DUT_ADMIN}
IS_DUT_ONLINE_CMD="ping -c 2 198.18.1.203 && ping -c 2 ${SENDER_LAB_IP}"

#Bench commands
# The IPsec benches of this directory use the equilibrium throughput method
# (Tisovsky & Baronak), like every existing result set under results/: it
# binary-searches the offered load for the rate the DUT sustains without loss,
# in Mb/s. Do NOT replace it by a plain pkt-gen blast, which measures the
# throughput under overload instead and is not comparable with those results.
# equilibrium drives both the generator and the receiver itself from the sender
# node, so the RECEIVER_* commands stay empty. It sets its own 5000 flows and
# takes the UDP load with -s (default 500B => 542B ethernet frame).
RECEIVER_START_CMD=""
RECEIVER_STOP_CMD=""
SENDER_START_CMD="equilibrium -${AF} -d ${DUT_LAB_IF_MAC_SENDER_SIDE} -t ${SENDER_LAB_IF} -r ${RECEIVER_LAB_IF}"
