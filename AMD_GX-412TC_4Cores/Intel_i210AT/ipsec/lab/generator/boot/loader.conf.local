# Packet generator and receiver (sm1) for the APU2 IPsec bench.
# This is the stock BSDRP loader.conf.local of this machine: nothing here is
# specific to the IPsec bench, the generator only pushes netmap traffic and
# does no crypto. Kept for the record so the lab can be rebuilt as it was.

# Multiconsole support, mandatory for IPMI SoL
boot_multicons="YES"
# Values description in loader(8) and loader.efi(8)
console="eficom,efi"
# Some emulated serial port with IPMI SoL doesn't use the default 0x3f8
# Search for the correct value with: grep 'uart.*port' /var/run/dmesg.boot
comconsole_port="0x2f8"

### Don't wait for USB (can prevent correct reboot)
hw.usb.no_shutdown_wait="1"

### Use next-gen MRSAS drivers in place of MFI for device supporting it
# This solves lot of [mfi] COMMAND 0x... TIMEOUT AFTER ## SECONDS
hw.mfi.mrsas_enable="1"

### Tune some global values ###
hw.usb.no_pf="1"	# Disable USB packet filtering

# Load The DPDK Longest Prefix Match (LPM) modules
dpdk_lpm4_load="YES"
dpdk_lpm6_load="YES"

# Load DXR: IPv4 lookup algo
fib_dxr_load="YES"

### Chelsio NIC tuning ###
# The cxl ports are not used by this bench (the 10G link to sm2 is disabled in
# rc.conf), these are kept from the machine's normal configuration.
hw.cxgbe.toecaps_allowed="0"
hw.cxgbe.rdmacaps_allowed="0"
hw.cxgbe.iscsicaps_allowed="0"
hw.cxgbe.fcoecaps_allowed="0"

hw.cxgbe.pause_settings="0"
