# bigone, WireGuard peer of the 10G bench. FRAGMENT, not a whole rc.conf:
# bigone is a workstation with its own configuration, so only the lines
# belonging to this bench are archived here. Apply them by hand.
#
# bigone is NOT nanobsd and is NOT driven by bench-lab.sh (see the note in
# ../../bench-lab-3nodes.equilibrium.config). It must not be rebooted between
# configuration sets. Its ix0 and ix1 are dedicated to the network
# performance lab, so replacing their addressing is expected.
#
# Each interface carries ONE direction:
#   ix0, VLAN 3: receives the encrypted stream from the DUT
#   ix1, VLAN 4: transmits the decrypted stream to the receiver

ifconfig_ix0="inet 198.18.1.2/24 -tso4 -tso6 -lro"
ifconfig_ix0_ipv6="inet6 2001:2:0:1::2 prefixlen 64"
ifconfig_ix1="inet 198.19.0.2/24 -tso4 -tso6 -lro"
ifconfig_ix1_ipv6="inet6 2001:2:0:8000::2 prefixlen 64"

# The receiver (sm2) runs its NIC in netmap mode and therefore cannot answer
# an ARP request or a neighbour solicitation. Both entries must be permanent
# or they expire mid-bench and forwarding stops: NDP goes STALE after ~30s,
# which shows up as ~8 good seconds then a flat 1 pps for the rest of the
# step. The static MAC entries on switch10g do NOT cover ARP/NDP, they only
# stop the switch forgetting which PORT the MAC is on.
static_ndp_pairs="receiver"
static_ndp_receiver="2001:2:0:8000::46 90:e2:ba:84:20:38"
static_arp_pairs="receiver"
static_arp_receiver="198.19.0.46 90:e2:ba:84:20:38"

# bigone decrypts and then forwards the clear traffic to the receiver.
gateway_enable="YES"
ipv6_gateway_enable="YES"

# Back through the tunnel towards the generator prefix.
static_routes="generator receiver"
route_generator="-net 198.18.0.0/16 198.18.2.4"
# The receiver route must be a /16, not just the connected /24: equilibrium
# generates destinations in 198.19.10.0/24, which 198.19.0.0/24 on ix1 does
# not cover. Without it those packets match bigone's default route and leave
# on its internet tunnel, so the DUT encrypts normally and the bench measures
# nothing arriving.
route_receiver="-net 198.19.0.0/16 198.19.0.46"
ipv6_static_routes="generator receiver"
ipv6_route_generator="2001:2:: -prefixlen 49 2001:2:0:2::4"
ipv6_route_receiver="2001:2:0:8000:: -prefixlen 49 2001:2:0:8000::46"

cloned_interfaces="wg0"
ifconfig_wg0="inet 198.18.2.2/24"
ifconfig_wg0_ipv6="inet6 2001:2:0:2::2 prefixlen 64"
# if_wg is already in bigone's own kld_list
