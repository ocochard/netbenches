#!/bin/sh
# Apply the WireGuard keys and peer to wg0.
#
# rc.conf creates wg0 and puts the addresses on it, but if_wg(4) takes its
# key and its peer from wg(8) alone, so this cannot be expressed in rc.conf
# on FreeBSD 16. /etc/rc.d/local runs this late in the boot, after
# cloned_interfaces has created wg0.
[ -f /etc/wg0.conf ] && /usr/bin/wg setconf wg0 /etc/wg0.conf
