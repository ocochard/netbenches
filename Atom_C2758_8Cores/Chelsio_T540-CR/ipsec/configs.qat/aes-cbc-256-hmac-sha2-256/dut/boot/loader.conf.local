##################################################################
# For modifying this file, you need to remount in read-write     #
# the /: mount -u rw /                                           #
#                                                                #
# Don't load modules not necessary for mounting local disk here: #
# - add module name to the kld_list variable in rc.conf          #
# Example for loading the padlock crypto module and coretemp:    #
# kld_list='padlock coretemp'                                    #
#                                                                #
# Don't put serial/dual console port value like these here too:  #
# - boot_serial                                                  #
# - comconsole_speed                                             #
# - console                                                      #
# Use /boot.config in place                                      #
##################################################################
#

### Text console in VT mode (we didn't use graphic)
hw.vga.textmode="1"

### Don't wait for USB (can prevent correct reboot)
hw.usb.no_shutdown_wait="1"

### Tune some global values ###
hw.usb.no_pf="1"	# Disable USB packet filtering

# aesni(4) is compiled into the BSDRP kernel (device aesni), so it needs no
# kld_list entry: aesni0 attaches at boot and registers with crypto(9).

# HT disabled
machdep.hyperthreading_allowed="0"

#Benchmark can be done from a GENERIC-NODEBUG that didn't include cxgbe drivers
t4fw_cfg_load="YES"
t5fw_cfg_load="YES"
if_cxgbe_load="YES"
hw.cxgbe.pause_settings="0"
comconsole_port="0x2f8"

hw.cxgbe.toecaps_allowed="0"
hw.cxgbe.rdmacaps_allowed="0"
hw.cxgbe.iscsicaps_allowed="0"
hw.cxgbe.fcoecaps_allowed="0"

### Intel QuickAssist (QAT): do NOT load from the loader
# qat_c2xxx_load="YES" in loader.conf PANICS FreeBSD 16 on this hardware:
# the driver attaches during early PCI enumeration and sleeps before the
# timer subsystem exists.
#
#   qat_c2xxx0: <Intel C2000 QuickAssist PF> ... at device 11.0 on pci0
#   qat_c2xxx0: disabling second AE
#   panic: timed sleep before timers are working
#   cpuid = 6 ; time = 1 ; Uptime: 1s
#     sleepq_set_timeout_sbt <- _sleep <- qat_adm_ring_send_init_msg
#     <- qat_adm_ring_send_init <- qat_start <- qat_attach
#     <- device_attach <- pci_attach <- acpi_pci_attach
#
# The result is a panic-reboot loop that needs console intervention, so the
# module is loaded from rc.conf via kld_list instead: by then rc(8) is
# running, timers work, and the same attach path succeeds. Note this
# contradicts qat_c2xxx(4), which documents the loader.conf method.
