#!/bin/sh
# Record the crypto provider state so a result set proves which drivers were
# live, rather than relying on notes. bench-lab.sh's BEFORE_CMD cats this.
{
	echo "--- kldstat (qat/aesni):"
	kldstat | grep -iE "qat|aesni" || echo "  none loaded"
	echo "--- crypto drivers registered:"
	sysctl -a 2>/dev/null | grep -E "%driver: (qat|qat_ocf|aesni|cryptosoft)"
	echo "--- qat device claimed:"
	pciconf -l 2>/dev/null | grep -iE "^qat" || echo "  no qat device claimed"
	echo "--- qat AE / fuse state:"
	dmesg | grep -iE "qat" | tail -3
	echo "--- qat counters (must be non-zero AFTER a run to prove QAT carried it):"
	sysctl dev.qat_c2xxx.0.stats 2>/dev/null || echo "  no qat stats"
} > /var/run/crypto-state.txt 2>&1
